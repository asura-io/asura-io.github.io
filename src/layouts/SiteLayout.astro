---
import '../styles/global.css';
const { title = 'gautama', description = '' } = Astro.props;
const isAbout = Astro.url.pathname.startsWith('/about');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">gautama</a>
      <nav aria-label="primary navigation">
        <a href="/#work" aria-current={!isAbout ? 'page' : undefined}>work</a>
        <a href="/about/" aria-current={isAbout ? 'page' : undefined}>about</a>
        <span class="nav-social">
          <a class="icon-link" href="https://www.instagram.com/gautama_studio/" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
              <circle cx="12" cy="12" r="4" />
              <circle class="icon-dot" cx="17.3" cy="6.8" r="1" />
            </svg>
          </a>
          <a class="icon-link" href="mailto:gautacharya@gmail.com" aria-label="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="1.5" />
              <path d="m4 6 8 6.5L20 6" />
            </svg>
          </a>
        </span>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <a class="footer-wordmark" href="/">gautama</a>
      <div class="footer-contact">
        <a href="mailto:gautacharya@gmail.com">gautacharya@gmail.com</a>
        <a href="https://www.instagram.com/gautama_studio/">Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </body>
</html>
