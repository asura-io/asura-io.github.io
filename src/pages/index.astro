---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
---
<SiteLayout>
  <section class="series-grid" aria-label="series">
    {series.map((item) => <a class="series-card" href={`/series/${item.id}/`}>
      {item.data.cover && <Image class="series-image" src={item.data.cover} alt={item.data.title} widths={[600, 1000, 1400]} sizes="(max-width: 640px) 100vw, 33vw" />}
      <div class="series-caption"><span>{item.data.title}</span></div>
    </a>)}
  </section>
</SiteLayout>
