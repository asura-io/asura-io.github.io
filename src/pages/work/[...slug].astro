---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths() { return (await getCollection('work')).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SiteLayout title={`${entry.data.title} — gautama`}><article class="detail"><div class="detail-head"><h1>{entry.data.title}</h1><a href="/work/">back</a></div><Image class="detail-image" src={entry.data.image} alt={entry.data.title} widths={[1000,1600,2200]} sizes="(max-width: 960px) 100vw, 70rem" /><div class="detail-info"><div><p>{entry.data.series}</p><p>{entry.data.year}</p></div><div><p>{entry.data.medium}</p><p>{entry.data.dimensions}</p></div></div>{entry.data.images?.length && <div class="detail-gallery">{entry.data.images.map((image, i) => <Image src={image} alt={`${entry.data.title} ${i + 2}`} widths={[800,1200]} sizes="(max-width: 640px) 100vw, 50vw" />)}</div>}<div class="about-copy"><Content /></div></article></SiteLayout>
