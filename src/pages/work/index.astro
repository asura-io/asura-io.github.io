---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<SiteLayout title="work — gautama"><div class="section-head"><h1>work</h1><span>{works.length}</span></div><section class="work-grid">{works.map((work) => <a class="work-card" href={`/work/${work.id}/`}><Image class="work-image" src={work.data.image} alt={work.data.title} widths={[600,1000,1400]} sizes="(max-width: 640px) 100vw, 48vw" /><div class="work-meta"><span>{work.data.title}</span><span>{work.data.year}</span></div></a>)}</section></SiteLayout>
