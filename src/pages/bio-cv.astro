---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import portrait from '../assets/images/about/gautama-portrait.jpg';
import SiteLayout from '../layouts/SiteLayout.astro';

const bioEntry = (await getCollection('bio'))[0];
const { Content } = await render(bioEntry);
const cv = (await getCollection('cv')).sort((a, b) => a.data.order - b.data.order);
---
<SiteLayout title="bio / cv — gautama"><article class="about-page">
  <Image class="about-portrait" src={portrait} alt="gautama in front of two paintings" widths={[800, 1200, 1600, 2200]} sizes="(max-width: 900px) 92vw, 48vw" loading="eager" />
  <div class="about-copy"><Content /></div>
  <div class="about-cv">
    {cv.map((section) => (
      <section class="cv-section">
        <h2>{section.data.heading}</h2>
        <div class="exhibition-list">
          {section.data.entries.map((entry) => (
            <p class="cv-row"><span class="cv-year">{entry.year}</span><span>{entry.title ? <Fragment><em>{entry.title}</em>, {entry.detail}</Fragment> : entry.detail}</span></p>
          ))}
        </div>
      </section>
    ))}
  </div>
</article></SiteLayout>
